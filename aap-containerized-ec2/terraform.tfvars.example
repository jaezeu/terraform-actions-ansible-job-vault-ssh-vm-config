region = "us-east-1"
name   = "aap"

# Restrict these to your own public IP, e.g. ["203.0.113.10/32"]
allowed_cidrs     = ["0.0.0.0/0"]
ssh_allowed_cidrs = ["0.0.0.0/0"]

instance_type    = "m6i.xlarge"
root_volume_size = 120

# registry.redhat.io credentials. A registry service account is recommended:
# https://access.redhat.com/terms-based-registry/
registry_username = "replace"
registry_password = "replace"

# Leave empty to have Terraform generate random passwords.
aap_admin_password        = ""
postgresql_admin_password = ""

install_automation_hub = true
install_eda            = true

tags = {
  Owner = "replace"
}
