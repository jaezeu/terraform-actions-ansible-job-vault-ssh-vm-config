# Ansible Automation Platform 2.5+ containerized installer inventory.
# Growth (all-in-one) topology on a single host. Generated by Terraform.

[automationgateway]
${aap_hostname} ansible_connection=local

[automationcontroller]
${aap_hostname} ansible_connection=local
%{ if install_automation_hub ~}

[automationhub]
${aap_hostname} ansible_connection=local
%{ endif ~}
%{ if install_eda ~}

[automationeda]
${aap_hostname} ansible_connection=local
%{ endif ~}

[database]
${aap_hostname} ansible_connection=local

[all:vars]
ansible_user=ec2-user

# Container registry used to pull AAP images
registry_username=${registry_username}
registry_password=${registry_password}

# Managed PostgreSQL
postgresql_admin_username=postgres
postgresql_admin_password=${postgresql_admin_password}

# Platform gateway
gateway_admin_password=${aap_admin_password}
gateway_pg_host=${aap_hostname}
gateway_pg_password=${postgresql_admin_password}

# Automation controller
controller_admin_password=${aap_admin_password}
controller_pg_host=${aap_hostname}
controller_pg_password=${postgresql_admin_password}
%{ if install_automation_hub ~}

# Automation hub
hub_admin_password=${aap_admin_password}
hub_pg_host=${aap_hostname}
hub_pg_password=${postgresql_admin_password}
%{ endif ~}
%{ if install_eda ~}

# Event-Driven Ansible
eda_admin_password=${aap_admin_password}
eda_pg_host=${aap_hostname}
eda_pg_password=${postgresql_admin_password}
%{ endif ~}

# Single host, so a standalone Redis is sufficient.
redis_mode=standalone
